{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbbl-hq-worker",
  "main": "src/worker/validation-contract-wrapper.ts",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  // Explicitly enable the workers.dev subdomain so the post-deploy health
  // check in deploy.yml can reach /ops/health without being challenged by
  // Cloudflare Bot Management (which only applies to the custom domain zone).
  // Workers with Assets default workers_dev to false — must opt back in.
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // MUST be `true` (not a path allowlist). The Worker's addSecurityHeaders()
    // wraps every response — including the SPA HTML shell fetched from the
    // ASSETS binding fallback — so Permissions-Policy, CSP, HSTS, and
    // X-Frame-Options reach the browser on page loads (e.g. /live).
    // A path-list value (["/api/*", ...]) routes non-matching requests
    // directly to ASSETS, bypassing the Worker entirely and stripping all
    // security headers from the HTML response. That silently breaks Twitch
    // embed autoplay on /live and any future per-page header contract.
    // With run_worker_first: true, the Worker calls env.ASSETS.fetch() for
    // non-API routes and wraps the response with addSecurityHeaders().
    "run_worker_first": true
  },
  "vars": {
    // Cloud Supabase project URL.
    "SUPABASE_URL": "https://ezanilxygnpucwkwpsoc.supabase.co",
    // Placeholder — overridden at deploy time by the SUPABASE_PUBLISHABLE_KEY wrangler
    // secret pushed from secrets.VITE_SUPABASE_ANON_KEY in deploy.yml.
    "SUPABASE_PUBLISHABLE_KEY": "your-supabase-anon-key-here",
    "SENTRY_DSN": ""
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbbl-hq-worker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  // Explicitly enable the workers.dev subdomain so the post-deploy health
  // check in deploy.yml can reach /ops/health without being challenged by
  // Cloudflare Bot Management (which only applies to the custom domain zone).
  // Workers with Assets default workers_dev to false — must opt back in.
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/webhooks/*", "/ops/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://ezanilxygnpucwkwpsoc.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImV6YW5pbHh5Z25wdWN3a3dwc29jIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzQ2MjI5OTIsImV4cCI6MjA5MDE5ODk5Mn0.kLbwopHDqf33H9flwIbO5XqfPYdi0wMqjeVJC76-Ceo",
    "SENTRY_DSN": ""
  }
}

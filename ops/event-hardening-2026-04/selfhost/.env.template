############################################################
# SBBL-HQ Self-Hosted Supabase Environment Configuration
# Copy to .env and replace all REPLACE_WITH_* placeholders
############################################################

# ─── Postgres ─────────────────────────────────────────────
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

DB_HOST=db
DB_PORT=5432

# ─── JWT / API Keys ──────────────────────────────────────
# Generate with: scripts/01-generate-keys.sh
JWT_SECRET=REPLACE_WITH_JWT_SECRET
ANON_KEY=REPLACE_WITH_ANON_KEY
SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY

# ─── GoTrue Auth ─────────────────────────────────────────
GOTRUE_JWT_SECRET=${JWT_SECRET}
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated

SITE_URL=https://sbbl-hq.icu
API_EXTERNAL_URL=https://api.sbbl-hq.icu
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999

GOTRUE_URI_ALLOW_LIST=https://sbbl-hq.icu,https://*.sbbl-hq.icu
GOTRUE_DISABLE_SIGNUP=false

# Password / breach protection
GOTRUE_PASSWORD_MIN_LENGTH=8
GOTRUE_PASSWORD_HIBP_ENABLED=true

# Captcha (Cloudflare Turnstile)
GOTRUE_SECURITY_CAPTCHA_ENABLED=true
GOTRUE_SECURITY_CAPTCHA_PROVIDER=turnstile
GOTRUE_SECURITY_CAPTCHA_SECRET=REPLACE_WITH_TURNSTILE_SECRET
GOTRUE_SECURITY_CAPTCHA_TIMEOUT=10s

# Rate limiting
GOTRUE_RATE_LIMIT_HEADER=X-Forwarded-For
GOTRUE_RATE_LIMIT_EMAIL_SENT=10000
GOTRUE_RATE_LIMIT_SMS_SENT=30
GOTRUE_RATE_LIMIT_TOKEN_REFRESH=10000
GOTRUE_RATE_LIMIT_VERIFY=10000
GOTRUE_RATE_LIMIT_ANONYMOUS=0

# ─── SMTP / Resend ───────────────────────────────────────
GOTRUE_SMTP_HOST=smtp.resend.com
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=resend
GOTRUE_SMTP_PASS=REPLACE_WITH_RESEND_API_KEY
GOTRUE_SMTP_SENDER_NAME=SBBL-HQ
GOTRUE_SMTP_ADMIN_EMAIL=noreply@sbbl-hq.icu
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_MAILER_URLPATHS_INVITE=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_RECOVERY=/auth/v1/verify
GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# ─── Studio / Dashboard ──────────────────────────────────
STUDIO_DEFAULT_ORGANIZATION=sbbl-hq
STUDIO_DEFAULT_PROJECT=sbbl-hq
SUPABASE_PUBLIC_URL=https://api.sbbl-hq.icu
STUDIO_PORT=3000

DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=REPLACE_WITH_DASHBOARD_PASSWORD

# ─── Kong API Gateway ────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ─── Misc Services ───────────────────────────────────────
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Storage
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800

# Realtime
REALTIME_IP_VERSION=IPv4

# Analytics
LOGFLARE_API_KEY=REPLACE_WITH_LOGFLARE_API_KEY
LOGFLARE_LOGGER_BACKEND_API_KEY=REPLACE_WITH_LOGFLARE_API_KEY

# ─── Domain (used by Caddy) ──────────────────────────────
SUPABASE_DOMAIN=api.sbbl-hq.icu

# ── Cloud Fallback (Supabase Pro) ───────────────────────────────────────────
# Used by failover scripts and the CF API Proxy Worker.
# JWT_SECRET must be synced to cloud via jwt-sync.sh before event start.
CLOUD_SUPABASE_URL=https://ezanilxygnpucwkwpsoc.supabase.co
CLOUD_SUPABASE_ANON_KEY=REPLACE_WITH_CLOUD_ANON_KEY
CLOUD_SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_CLOUD_SERVICE_ROLE_KEY
SUPABASE_MGMT_ACCESS_TOKEN=REPLACE_WITH_SUPABASE_MGMT_TOKEN
# ^ Get from: https://supabase.com/dashboard/account/tokens

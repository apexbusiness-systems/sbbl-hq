# SBBL-HQ Caddyfile — auto HTTPS via Let's Encrypt
# Caddy docs: https://caddyserver.com/docs/
#
# sbbl-hq.icu     → App domain (Studio dashboard + Supabase service paths)
# api.sbbl-hq.icu → Supabase API domain (API_EXTERNAL_URL / SUPABASE_URL)
#                   All client API calls route here → Kong on port 8000.
#                   Without this block Caddy has no vhost for api.sbbl-hq.icu
#                   and Kong is never reached (RC-0 / RC-8 fix).

# ── App domain ────────────────────────────────────────────────────────────────
sbbl-hq.icu {
    # ── Kong (main API gateway) ───────────────────────────
    # All traffic except realtime and storage goes through Kong
    reverse_proxy /auth/*     kong:8000
    reverse_proxy /rest/*     kong:8000
    reverse_proxy /functions/* kong:8000
    reverse_proxy /graphql/*  kong:8000

    # ── Realtime — WebSocket pass-through ─────────────────
    reverse_proxy /realtime/* realtime:4000 {
        header_up Upgrade {http.request.header.Upgrade}
        header_up Connection {http.request.header.Connection}
        header_up Host {http.request.host}
        header_up X-Real-IP {http.request.remote.host}
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Proto https
    }

    # ── Storage — direct to storage service ───────────────
    reverse_proxy /storage/* storage:5000 {
        header_up Host {http.request.host}
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Proto https
    }

    # ── Dashboard (Studio) ────────────────────────────────
    reverse_proxy /   studio:3000

    # ── Global security headers ───────────────────────────
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # ── Compression ───────────────────────────────────────
    encode gzip zstd

    # ── Access log ────────────────────────────────────────
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}

# ── Supabase API domain ───────────────────────────────────────────────────────
# This is the API_EXTERNAL_URL / SUPABASE_URL target.
# Clients call https://api.sbbl-hq.icu/auth/v1/, /rest/v1/, /realtime/v1/, etc.
# The Cloudflare Worker's SUPABASE_URL secret must equal https://api.sbbl-hq.icu.
api.sbbl-hq.icu {
    reverse_proxy /auth/*      kong:8000
    reverse_proxy /rest/*      kong:8000
    reverse_proxy /functions/* kong:8000
    reverse_proxy /graphql/*   kong:8000

    reverse_proxy /storage/* storage:5000 {
        header_up Host {http.request.host}
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Proto https
    }

    reverse_proxy /realtime/* realtime:4000 {
        header_up Upgrade {http.request.header.Upgrade}
        header_up Connection {http.request.header.Connection}
        header_up Host {http.request.host}
        header_up X-Real-IP {http.request.remote.host}
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Proto https
    }

    # All unmatched paths (e.g. /meta, /pg) also flow to Kong
    reverse_proxy /* kong:8000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    encode gzip zstd

    log {
        output file /var/log/caddy/api-access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
    }
}

# ── HTTP → HTTPS redirects ────────────────────────────────────────────────────
http://sbbl-hq.icu {
    redir https://sbbl-hq.icu{uri} permanent
}

http://api.sbbl-hq.icu {
    redir https://api.sbbl-hq.icu{uri} permanent
}

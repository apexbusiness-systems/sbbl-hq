{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbbl-hq-worker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/webhooks/*", "/ops/*"]
  },
  "routes": [
    {
      "pattern": "sbbl-hq.icu",
      "custom_domain": true
    },
    {
      "pattern": "www.sbbl-hq.icu",
      "custom_domain": true
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://ezanilxygnpucwkwpsoc.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_5uIVxDWuaI916HXVN9Mb8A_jhrYLPYz",
    // Sentry DSN for the Worker — fill in after creating sbbl-hq-worker project in Sentry.
    // Worker Sentry project: Sentry Dashboard → sbbl-hq-worker → Settings → Client Keys (DSN)
    "SENTRY_DSN": ""
  },
  "env": {
    "staging": {
      "name": "sbbl-hq-staging",
      "vars": {
        "SUPABASE_URL": "https://ezanilxygnpucwkwpsoc.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_5uIVxDWuaI916HXVN9Mb8A_jhrYLPYz",
        "SENTRY_DSN": ""
      }
    }
  }
}

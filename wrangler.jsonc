{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sbbl-hq",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-03-27",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/webhooks/*", "/ops/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://ezanilxygnpucwkwpsoc.supabase.co"
  },
  "env": {
    "staging": {
      "name": "sbbl-hq-staging",
      "vars": {
        "SUPABASE_URL": "https://ezanilxygnpucwkwpsoc.supabase.co"
      }
    }
  }
}

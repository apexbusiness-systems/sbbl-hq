{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ┌─────────────────────────────────────────────────────────────────────────┐
  // │ CRITICAL: Worker name MUST be "sbbl-hq" — all Cloudflare secrets       │
  // │ (SUPABASE_SERVICE_ROLE_KEY, STRIPE_SECRET_KEY, etc.) are bound to this  │
  // │ name. Changing it deploys a NEW worker with NO secrets, breaking ALL    │
  // │ API routes. DO NOT rename without re-setting every secret.             │
  // └─────────────────────────────────────────────────────────────────────────┘
  "name": "sbbl-hq",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  // REQUIRED SECRETS — set via `wrangler secret put <KEY>` before deploying:
  //   SUPABASE_SERVICE_ROLE_KEY   — Supabase service role key (never commit)
  //   STRIPE_SECRET_KEY           — Stripe live/test secret key
  //   STRIPE_WEBHOOK_SECRET       — Stripe webhook signing secret
  //   RESEND_API_KEY              — Resend email API key
  //   GROQ_API_KEY                — Groq Vision API key (enables POTG image parser)
  //   OMNIHUB_SIGNING_SECRET      — OmniHub webhook HMAC signing secret (optional)
  //   OMNIHUB_SYNC_URL            — OmniHub sync endpoint URL (optional)
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/webhooks/*", "/ops/*"]
  },
  "routes": [
    {
      "pattern": "sbbl-hq.icu",
      "custom_domain": true
    },
    {
      "pattern": "www.sbbl-hq.icu",
      "custom_domain": true
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://ezanilxygnpucwkwpsoc.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_5uIVxDWuaI916HXVN9Mb8A_jhrYLPYz",
    // Sentry DSN for the Worker — fill in after creating sbbl-hq-worker project in Sentry.
    // Worker Sentry project: Sentry Dashboard → sbbl-hq-worker → Settings → Client Keys (DSN)
    "SENTRY_DSN": ""
  },
  "env": {
    "staging": {
      "name": "sbbl-hq-staging",
      "vars": {
        "SUPABASE_URL": "https://ezanilxygnpucwkwpsoc.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_5uIVxDWuaI916HXVN9Mb8A_jhrYLPYz",
        "SENTRY_DSN": ""
      }
    }
  }
}

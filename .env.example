VITE_APP_NAME=SBBL HQ
# Sentry — error monitoring, tracing, session replay
# Get DSN from: Sentry Dashboard → sbbl-hq-frontend → Settings → Client Keys
VITE_SENTRY_DSN=
# Git SHA or semver injected at build time (e.g. export VITE_APP_VERSION=$(git rev-parse --short HEAD))
VITE_APP_VERSION=
# Build-time Sentry source map upload (never commit these)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=apex-business-systems
SENTRY_PROJECT=sbbl-hq-frontend
# Worker Sentry project (set in wrangler.jsonc [vars] for production)
SENTRY_DSN_WORKER=
VITE_DEFAULT_LEAGUE=SBBL
VITE_DEFAULT_PPV_PRICE=2.50
VITE_PUBLIC_BASE_URL=http://localhost:5173
# CANONICAL build-time Supabase vars — use ANON KEY (eyJ... JWT from Supabase dashboard > Project Settings > API)
# VITE_SUPABASE_PUBLISHABLE_KEY is a deprecated alias — do NOT use it. ANON_KEY is the source of truth.
VITE_SUPABASE_URL=https://supabase.sbbl-hq.icu
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional: Cloudflare Turnstile site key for Supabase captcha-protected auth.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here
# Fallback stream URL used when no URL is set on the game row or in the admin panel.
# Supports YouTube live links, HLS (.m3u8), or any URL react-player handles.
VITE_STREAM_URL=https://youtube.com/live/qQcQsk4CBHE?feature=share
TEST_USER_EMAIL=qa-stream-user@example.com
TEST_USER_PASSWORD=change-me

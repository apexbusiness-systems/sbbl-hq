    "test:ci:shard2": "vitest run --reporter=dot --max-workers=1 --shard=2/2",
    "simulate:broadcast": "tsx scripts/simulate-broadcast.ts",
    "test:selfhost:owner": "playwright test e2e/selfhost-owner-auth-ingest.spec.ts --project=chromium"
